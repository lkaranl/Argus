# ==============================================================================
# ARGUS — CCTV Command Hub (Variáveis de Ambiente)
# ==============================================================================
# Renomeie este arquivo para .env e preencha com suas credenciais.
# NUNCA commite o arquivo .env no repositório!

# Porta e Interface de Rede do Servidor HTTP
ARGUS_PORT=8080
ARGUS_BIND_ADDRESS=0.0.0.0

# ------------------------------------------------------------------------------
# Usina Fotovoltaica (Huawei FusionSolar Kiosk)
# ------------------------------------------------------------------------------
# Obtenha o token público 'kk' a partir do link de compartilhamento de quiosque da Huawei:
# Ex: https://intl.fusionsolar.huawei.com/pvmswebsite/nologin/assets/build/cloud.html#/kiosk?kk=SEU_TOKEN_AQUI
FUSIONSOLAR_ENABLED=true
FUSIONSOLAR_TOKEN=EM6wrnyAhBtOFvD7rdNu045xGpwb1bGD
FUSIONSOLAR_KIOSK_URL=https://intl.fusionsolar.huawei.com/pvmswebsite/nologin/assets/build/cloud.html#/kiosk?kk=EM6wrnyAhBtOFvD7rdNu045xGpwb1bGD

# ------------------------------------------------------------------------------
# Câmeras CFTV (URLs RTSP com Autenticação)
# ------------------------------------------------------------------------------
# Use formato H.264 estrito (sub-stream ou main-stream):
CAM_1_RTSP=rtsp://admin:senha123@192.168.1.101:554/stream1
CAM_2_RTSP=rtsp://admin:senha123@192.168.1.102:554/stream1
CAM_3_RTSP=rtsp://admin:senha123@192.168.1.103:554/stream1
